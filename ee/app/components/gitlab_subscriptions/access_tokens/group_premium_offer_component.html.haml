= render Pajamas::CardComponent.new(card_options: { class: 'gl-my-6' }) do |c|
  - c.with_body do
    %h4.gl-heading-4.gl-mb-4
      = s_('AccessTokens|Try group access tokens with Premium')
    %p.gl-mt-0.gl-mb-4.gl-text-default
      = body_text
    .gl-flex.gl-flex-wrap.gl-gap-3
      = render Pajamas::ButtonComponent.new(variant: :confirm, category: :primary, href: upgrade_to_premium_url, button_options: { data: { event_tracking: UPGRADE_EVENT, testid: 'upgrade-to-premium-button' } }) do
        = s_('AccessTokens|Upgrade to Premium')
      = render Pajamas::ButtonComponent.new(variant: :default, category: :primary, href: explore_plans_url, button_options: { data: { event_tracking: EXPLORE_EVENT, testid: 'explore-plans-button' } }) do
        = s_('AccessTokens|Explore plans')
    %p.gl-mt-4.gl-mb-0.gl-text-sm.gl-text-subtle
      = s_('AccessTokens|You can still manage existing tokens.')
