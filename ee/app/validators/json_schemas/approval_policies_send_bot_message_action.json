{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Approval policy `send_bot_message` action",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "internal"
      ],
      "description": "Specifies whether the bot comment is publicly visible or an internal note. Defaults to `public`."
    }
  }
}
