{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Compiled rules of a policy store policy",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "type",
      "rego"
    ],
    "properties": {
      "type": {
        "type": "string",
        "minLength": 1
      },
      "value": {
        "type": [
          "string",
          "object"
        ]
      },
      "rego": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
