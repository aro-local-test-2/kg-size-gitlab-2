- root_namespace = @group&.root_ancestor || @project&.root_ancestor
- entitlement = secrets_manager_entitlement_root_namespace(root_namespace, current_user)
- secrets_manager_path = @group ? group_secrets_path(@group) : project_secrets_path(@project)

- if Feature.enabled?(:secrets_manager_paid_experience, root_namespace) && entitlement&.state == :trial_eligible
  %div
    = render Pajamas::AlertComponent.new(variant: :info, title: s_('SecretsManager|Keep secrets secure with GitLab Secrets Manager'), dismissible: false, alert_options: { class: 'gl-mb-4' }) do |c|
      - if can?(current_user, :admin_group, root_namespace) # rubocop:disable Gitlab/Authz/PermissionCheck -- coarse owner check is acceptable for this trial nudge
        - c.with_body do
          = s_('SecretsManager|Protect your organization from potential leaks.')
          = link_to _('Learn more.'), help_page_path('ci/secrets/secrets_manager/_index.md'), target: '_blank', rel: 'noopener noreferrer'
        - c.with_actions do
          = render Pajamas::ButtonComponent.new(href: secrets_manager_path, variant: :confirm) do
            = _('Start free 30-day trial')
      - else
        - c.with_body do
          = s_('SecretsManager|Contact your GitLab administrator for a trial.')
          = link_to _('Learn more.'), help_page_path('ci/secrets/secrets_manager/_index.md'), target: '_blank', rel: 'noopener noreferrer'
