- page_title s_('SubscriptionRegistration|Complete your purchase')
- content_for :hide_empty_navbar, true
- content_for :body_class, '!gl-bg-default'

%header.gl-flex.gl-items-center.gl-gap-3.gl-border-b.gl-border-default.gl-px-5.gl-py-4
  = brand_header_logo(add_gitlab_logo_text: true)
  %span.gl-h-6.gl-w-px.gl-bg-strong{ aria: { hidden: true } }
  %span.gl-heading-2.gl-m-0{ data: { testid: 'customers-portal-label' } }
    = s_('SubscriptionRegistration|Customers Portal')

.gl-mx-auto.gl-flex.gl-flex-col.gl-items-center.gl-mt-11.gl-max-w-lg.gl-text-center
  %h2.gl-heading-1.gl-mb-3{ data: { testid: 'complete-purchase-heading' } }
    = s_('SubscriptionRegistration|Complete your purchase')
  %p.gl-mb-5
    = s_("SubscriptionRegistration|You'll use your GitLab.com account to access Customers Portal, where you can finish your purchase and manage your subscription.")
  = render Pajamas::ButtonComponent.new(href: @customers_portal_url, variant: :confirm) do
    = s_('SubscriptionRegistration|Continue to Customers Portal')
