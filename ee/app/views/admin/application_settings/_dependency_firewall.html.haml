= gitlab_ui_form_for @application_setting, url: security_and_compliance_admin_application_settings_path(anchor: 'js-dependency-firewall-settings'), html: { class: 'fieldset-form', id: 'dependency-firewall-settings' } do |f|
  = form_errors(@application_setting)

  %fieldset
    .form-group
      = f.gitlab_ui_checkbox_component :dependency_firewall_enabled,
        s_('DependencyFirewall|Enable dependency firewall'),
        help_text: s_('DependencyFirewall|Protect against malicious and suspicious packages for all projects in this GitLab instance.')

  = f.submit _('Save changes'), pajamas_button: true
