= gitlab_ui_form_for @application_setting, url: general_admin_application_settings_path(anchor: 'js-secret-detection-settings'), html: { class: 'fieldset-form', id: 'secret-detection-settings' } do |f|
  = form_errors(@application_setting)

  %fieldset
    .form-group.gl-mb-0
      = f.label :secret_push_protection_mode, s_('AdminSettings|Secret Push Protection'), class: 'label-bold'
      %span.form-text.gl-mt-0.gl-mb-3#secret_push_protection-help
        = _('Prevent secrets such as keys and API tokens from being committed to any repository in this GitLab instance.')

      = f.gitlab_ui_radio_component :secret_push_protection_mode, 'disabled', _('Disabled'),
        help_text: _('This feature is not available for projects in the instance.'),
        radio_options: { checked: !@application_setting.secret_push_protection_available, data: { testid: 'secret-push-protection-mode-disabled' } }

      = f.gitlab_ui_radio_component :secret_push_protection_mode, 'available', _('Available'),
        help_text: _('This feature is available for each project in the instance.'),
        radio_options: { checked: @application_setting.secret_push_protection_available && !@application_setting.secret_push_protection_enforced, data: { testid: 'secret-push-protection-mode-available' } }

      = f.gitlab_ui_radio_component :secret_push_protection_mode, 'enforced', _('Enforced'),
        help_text: _('This feature is automatically enforced for all projects in the instance.'),
        radio_options: { checked: @application_setting.secret_push_protection_enforced, data: { testid: 'secret-push-protection-mode-enforced' } }

  = f.submit _('Save changes'), pajamas_button: true
