%h2.gl-heading-2= _('License overview')
.gl-p-3.gl-pl-4.gl-mb-5.gl-justify-between.gl-items-center.gl-bg-section.gl-border.gl-border-section.gl-rounded-xl{ class: "@sm/panel:gl-flex" }
  .gl-mb-0.gl-flex-wrap.gl-items-center{ class: "@md/panel:gl-flex" }
    .gl-mr-5
      = sprite_icon('license', css_class: 'gl-fill-icon-subtle')
      = _('Plan:')
      %strong= @license.plan.capitalize
    .gl-mr-5
      = render 'admin/licenses/license_status'
    .gl-mr-5
      = _('Licensed to:')
      %strong= @license.licensee_name
      = "(#{@license.licensee_email})"
    .gl-mr-5
      = _('Type:')
      - case @license.license_type
      - when 'online_cloud'
        %strong= _('Online license')
      - when 'offline_cloud'
        %strong= _('Offline license')
      - when 'legacy_license'
        %strong= _('Legacy license')
  %div
    - if current_user.can_admin_all_resources?
      = link_button_to _('View details'), admin_subscription_path, class: 'gl-w-full gl-mt-3 @sm/panel:gl-mt-0'
