-# EE:Self Managed
= render Onboarding::ActionCardComponent.new(title: _('Unlock more features with GitLab Ultimate'),
  description: _('GitLab is free to use. Many features for larger teams are part of our %{link_start}paid products%{link_end}. You can try Ultimate for free without any obligation or payment details.').html_safe % { link_start: "<a href='#{promo_pricing_url}'>".html_safe, link_end: '</a>'.html_safe },
  icon: 'lock') do
  = link_button_to(new_self_managed_trials_path, variant: :confirm, data: { event_tracking: 'click_start_trial_cta_sm_project_dashboard' }) do
    = _('Start free trial')
