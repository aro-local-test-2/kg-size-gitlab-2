- page_title _("CI/CD Analytics")

= render ::Layouts::PageHeadingComponent.new(_("CI/CD Analytics"))
- is_root_group = @group && @group.root?

#js-group-ci-cd-analytics-app{ data: { group_full_path: @group.full_path,
