{
  "version": 1,
  "name": "ISMAP",
  "description": "ISMAP compliance requirements",
  "color": "#D11919",
  "requirements": [
    {
      "name": "6.1.2 Segregation of duties",
      "description": "Conflicting duties and areas of responsibility should be segregated to reduce opportunities for unauthorized or unintentional modification or misuse of the organization's assets.",
      "controls": [
        {
          "name": "minimum_approvals_required_2",
          "control_type": "internal",
          "expression": {
            "field": "minimum_approvals_required",
            "operator": ">=",
            "value": 2
          }
        },
        {
          "name": "merge_request_prevent_author_approval",
          "control_type": "internal",
          "expression": {
            "field": "merge_request_prevent_author_approval",
            "operator": "=",
            "value": true
          }
        },
