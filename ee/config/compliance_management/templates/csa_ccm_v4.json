{
  "version": 1,
  "name": "CSA CCM v4",
  "description": "CSA CCM v4 compliance requirements",
  "color": "#2F5496",
  "requirements": [
    {
      "name": "CCC-02 Quality Testing",
      "description": "Follow a defined quality change control, approval and testing process with established baselines, testing, and release standards.",
      "controls": [
        {
          "name": "default_branch_protected",
          "control_type": "internal",
          "expression": {
            "field": "default_branch_protected",
            "operator": "=",
            "value": true
          }
        },
        {
          "name": "scanner_code_quality_running",
          "control_type": "internal",
          "expression": {
            "operator": "=",
            "field": "scanner_code_quality_running",
            "value": true
          }
        }
      ]
    },
    {
      "name": "CCC-04 Unauthorized Change Protection",
      "description": "Restrict the unauthorized addition, removal, update, and management of organization assets.",
      "controls": [
        {
          "name": "default_branch_protected",
          "control_type": "internal",
          "expression": {
            "field": "default_branch_protected",
            "operator": "=",
            "value": true
          }
        }
      ]
    },
    {
      "name": "IAM-04 Separation of Duties",
      "description": "Employ the separation of duties principle when implementing information system access.",
      "controls": [
        {
          "name": "minimum_approvals_required_2",
          "control_type": "internal",
          "expression": {
            "field": "minimum_approvals_required",
            "operator": ">=",
            "value": 2
          }
        },
        {
          "name": "merge_request_prevent_author_approval",
          "control_type": "internal",
          "expression": {
            "field": "merge_request_prevent_author_approval",
            "operator": "=",
            "value": true
          }
        },
        {
          "name": "merge_request_prevent_committers_approval",
          "control_type": "internal",
          "expression": {
            "field": "merge_request_prevent_committers_approval",
            "operator": "=",
            "value": true
          }
        },
        {
          "name": "merge_requests_approval_rules_prevent_editing",
          "control_type": "internal",
          "expression": {
            "field": "merge_requests_approval_rules_prevent_editing",
            "operator": "=",
            "value": true
          }
        }
      ]
    },
    {
      "name": "IAM-15 Passwords Management",
      "description": "Define, implement and evaluate processes, procedures and technical measures for the secure management of passwords.",
      "controls": [
        {
          "name": "scanner_secret_detection_running",
          "control_type": "internal",
          "expression": {
            "field": "scanner_secret_detection_running",
            "operator": "=",
            "value": true
          }
        }
      ]
    },
    {
      "name": "TVM-05 External Library Vulnerabilities",
      "description": "Define, implement and evaluate processes, procedures and technical measures to identify updates for applications which use third party or open source libraries according to the organization's vulnerability management policy.",
      "controls": [
        {
          "name": "scanner_container_scanning_running",
          "control_type": "internal",
          "expression": {
            "field": "scanner_container_scanning_running",
            "operator": "=",
            "value": true
          }
        }
      ]
    },
    {
      "name": "TVM-07 Vulnerability Identification",
      "description": "Define, implement and evaluate processes, procedures and technical measures for the detection of vulnerabilities on organizationally managed assets at least monthly.",
      "controls": [
        {
          "name": "scanner_dep_scanning_running",
          "control_type": "internal",
          "expression": {
            "field": "scanner_dep_scanning_running",
            "operator": "=",
            "value": true
          }
        },
        {
          "name": "scanner_container_scanning_running",
